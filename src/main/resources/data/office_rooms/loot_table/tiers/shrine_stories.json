       "components": {
        "minecraft:written_book_content": {
         "title": "Last Warning",
         "author": "Dr. M. Ellison",
         "generation": 2,
         "resolved": true,
         "pages": [
          {
           "text": "We did it at the quarry. Sand on the coral. The air folded and we walked in, five of us."
          },
          {
           "text": "I am the only one who came back, and I am not sure I came back all the way. I still hear the hum at night."
          },
          {
           "text": "There are things in the halls. One with a wolf's body and a man's face. One that is only a smile. One that screams."
          },
          {
           "text": "Those who dare will never leave."
          },
          {
           "text": "Bury the chest. Burn this book. Go home."
          }
         ]
        }
       }
      }
     ]
    },
    {
     "type": "minecraft:item",
