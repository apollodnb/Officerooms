         "title": "Prayer",
         "author": "unknown",
         "generation": 2,
         "resolved": true,
         "pages": [
          {
           "text": "Grey carpet, white walls, keep us.\nHumming light, keep us.\nLong corridor, keep us.\nDo not open, keep us."
          },
          {
           "text": "We left the offering. We did not open the door."
          },
          {
           "text": "Someone will. Someone always does."
